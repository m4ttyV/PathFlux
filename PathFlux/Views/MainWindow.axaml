<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PathFlux.ViewModels"
        xmlns:domain="using:PathFlux.Domain"
        x:Class="PathFlux.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="PathFlux — выборочная маршрутизация" Background="{DynamicResource AppBackground}" Width="1180" Height="830"
        MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Icon="/Assets/Branding/pathflux.ico">
  <Window.Styles>
    <Style Selector="TextBlock.hint"><Setter Property="Opacity" Value="0.64"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#7161EF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style Selector="TabItem"><Setter Property="Padding" Value="16,13"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,22,28,18" RowSpacing="15">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="/Assets/Branding/pathflux-logo.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Логотип PathFlux" ToolTip.Tip="PathFlux · свой маршрут для каждого приложения"/>
        <StackPanel Spacing="1"><TextBlock Text="PathFlux" FontSize="25" FontWeight="Bold"/><TextBlock Text="Приложения выбирают свой маршрут" Classes="hint"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Как пользоваться" Click="OpenGuide" ToolTip.Tip="Пошаговая инструкция: от установки до первого приложения"/>
        <Button Content="Проверить" Command="{Binding ValidateCommand}" IsEnabled="{Binding CanUseTools}"/>
        <Button Content="Запустить" Classes="accent" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
        <Button Content="Остановить" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="card" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
        <StackPanel><TextBlock Text="СОСТОЯНИЕ ДВИЖКА" Classes="hint"/><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="17"/></StackPanel>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap"/><TextBlock Text="{Binding EditingHint}" Classes="hint"/></StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Обзор">
        <ScrollViewer><StackPanel Spacing="18" Margin="0,18,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="Настроено локально" Classes="hint"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding ProfileCount}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="прокси-профилей" VerticalAlignment="Center"/><TextBlock Text="/" FontSize="27" Opacity="0.4" VerticalAlignment="Center"/><TextBlock Text="{Binding RuleCount}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="правил" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Остальные приложения → Direct. Сначала внутренние исключения, затем правила по возрастанию приоритета." Classes="hint"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="card"><StackPanel Spacing="8"><TextBlock Text="Реальные возможности" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding CapabilityText}" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="Проверка прокси подтверждает доступность сервера. После запуска проверьте маршрут приложения. Дерево дочерних процессов остаётся Experimental." Classes="hint" TextWrapping="Wrap"/></StackPanel></Border>
          </Grid>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Начало работы" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. В «Настройках» нажмите «Установить движок PathFlux».&#10;2. В «Профилях» укажите адрес, порт и при необходимости логин и пароль своего прокси.&#10;3. В «Процессах» выберите приложение и создайте правило по имени.&#10;4. Нажмите «Проверить», затем «Запустить» и подтвердите запрос Windows.&#10;5. Для подробностей откройте «Как пользоваться» вверху окна." TextWrapping="Wrap"/><TextBlock Text="Для голоса и демонстрации экрана разрешите UDP в настройках и выберите «TCP + UDP» в правиле. Нужен SOCKS5 с поддержкой UDP. Точное дерево PID пока Experimental и работает только с TCP. Системный kill switch отсутствует, DNS остаётся системным." Classes="hint"/></StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Проверка конфигурации" FontSize="18" FontWeight="SemiBold"/><SelectableTextBlock Text="{Binding ValidationText}" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Профили">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="20" Margin="0,18,0,0">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <TextBlock Text="Прокси-профили" Classes="heading"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
              <ListBox.ItemTemplate><DataTemplate x:DataType="domain:ProxyProfile"><StackPanel Spacing="4" Margin="4,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Protocol}" Classes="hint"/><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="{Binding Host}" Classes="hint"/><TextBlock Text=":" Classes="hint"/><TextBlock Text="{Binding Port}" Classes="hint"/></StackPanel><CheckBox Content="Включён" IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="＋ Новый профиль" Command="{Binding NewProfileCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>
          <ScrollViewer Grid.Column="1"><Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Параметры профиля" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ProfileUdpStatus}" Classes="hint"/>
            <TextBlock Text="Название" Classes="label"/><TextBox Text="{Binding ProfileName}" MaxLength="120"/>
            <Grid ColumnDefinitions="*,140" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock Text="Протокол" Classes="label"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding ProfileProtocol}"/></StackPanel><CheckBox Grid.Column="1" Content="Включён" IsChecked="{Binding ProfileEnabled}" VerticalAlignment="Bottom"/></Grid>
            <Grid ColumnDefinitions="*,120" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock Text="Хост / IP" Classes="label"/><TextBox Text="{Binding ProfileHost}" Watermark="proxy.example.org"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Порт" Classes="label"/><TextBox Text="{Binding ProfilePort}"/></StackPanel></Grid>
            <StackPanel IsVisible="{Binding IsSocks}" Spacing="8"><TextBlock Text="UDP" Classes="label"/><TextBlock Text="{Binding ProfileUdpModeSummary}" FontWeight="SemiBold"/><TextBlock Text="Для нового профиля выбран автоматический режим. SOCKS5 сообщает релей сам; порты локального Docker определяются через Docker Desktop. При неоднозначности пакеты блокируются, без обхода прокси." Classes="hint"/><Expander Header="Дополнительно: режим UDP и порты Docker"><StackPanel Spacing="10" Margin="0,10,0,0"><ComboBox ItemsSource="{Binding UdpRelayModeNames}" SelectedIndex="{Binding ProfileUdpModeIndex}"/><TextBlock Text="Если автоматическое определение недоступно, выберите ручной режим Docker и укажите диапазон, опубликованный на 127.0.0.1. В ручном режиме внутренний и внешний номера портов должны совпадать." Classes="hint"/><Grid IsVisible="{Binding IsDockerNat}" ColumnDefinitions="*,*" ColumnSpacing="10"><TextBox Text="{Binding ProfileUdpPortFirst}" Watermark="Начало диапазона UDP"/><TextBox Grid.Column="1" Text="{Binding ProfileUdpPortLast}" Watermark="Конец диапазона UDP"/></Grid></StackPanel></Expander></StackPanel><StackPanel IsVisible="{Binding IsHttps}" Spacing="8"><TextBlock Text="TLS server name / SNI" Classes="label"/><TextBox Text="{Binding ProfileTlsServerName}" Watermark="Необязательно; по умолчанию хост"/><TextBlock Text="Проверка TLS-сертификата обязательна." Classes="hint"/></StackPanel>
            <StackPanel IsVisible="{Binding IsSocks}" Spacing="6"><CheckBox IsChecked="{Binding ProfileUseTlsServerNameForTcp}"><TextBlock Text="Совместимость TCP с IPv4 (рекомендуется)" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Только для IPv6 TCP с открытым TLS/SNI: получить IPv4 через DoH JSON и соединиться с ним через тот же SOCKS5. Проверка сертификатов обязательна. Глобальные DNS/IPv6 не меняются, без SNI исходный адрес сохраняется. Резолвер видит запрошенное имя." Classes="hint"/></StackPanel>
            <StackPanel IsVisible="{Binding ShowTcpIpv4Settings}" Spacing="6"><TextBlock Text="DoH JSON через SOCKS5 (HTTPS, буквальный IPv4)" Classes="label"/><TextBox Text="{Binding ProfileTcpIpv4DohServer}" Watermark="https://1.1.1.1/dns-query"/></StackPanel><TextBlock Text="Авторизация" Classes="label"/><TextBlock Text="{Binding CredentialStatus}" Classes="hint"/>
            <CheckBox Content="Записать / заменить логин и пароль" IsChecked="{Binding ReplaceCredentials}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding ReplaceCredentials}"><TextBox Text="{Binding ProfileUsername}" Watermark="Логин"/><TextBox Grid.Column="1" Text="{Binding ProfilePassword}" PasswordChar="●" Watermark="Пароль"/></Grid>
            <CheckBox Content="Удалить сохранённую авторизацию" IsChecked="{Binding RemoveCredentials}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button Content="Сохранить" Classes="accent" Command="{Binding SaveProfileCommand}"/><Button Content="Дублировать" Command="{Binding DuplicateProfileCommand}"/><Button Content="Удалить" Command="{Binding DeleteProfileCommand}"/></StackPanel>
            <TextBlock Text="При копировании секреты не переносятся. Профиль с назначенными правилами удалить нельзя." Classes="hint"/>
          </StackPanel></Border></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Правила">
        <Grid ColumnDefinitions="330,*" ColumnSpacing="20" Margin="0,18,0,0">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12"><TextBlock Text="Маршруты приложений" Classes="heading"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"><ListBox.ItemTemplate><DataTemplate x:DataType="domain:RoutingRule"><StackPanel Spacing="4" Margin="4,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Selector.Value}" Classes="hint" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Priority}"/><TextBlock Text="{Binding Action}"/><TextBlock Text="{Binding Network}" Classes="hint"/></StackPanel><CheckBox Content="Включено" IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Button Grid.Row="2" Content="＋ Новое правило" Command="{Binding NewRuleCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </Grid>
          <ScrollViewer Grid.Column="1"><Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Правило маршрутизации" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Имя / путь применяется ко всем совпавшим экземплярам. Точный PID привязан к экземпляру; после перезапуска корня создайте новое правило." Classes="hint"/>
            <TextBlock Text="Название" Classes="label"/><TextBox Text="{Binding RuleName}" Watermark="Понятное вам название правила" MaxLength="120"/>
            <Grid ColumnDefinitions="*,140" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock Text="Приоритет (меньше → раньше)" Classes="label"/><TextBox Text="{Binding RulePriority}"/></StackPanel><CheckBox Grid.Column="1" Content="Включено" IsChecked="{Binding RuleEnabled}" VerticalAlignment="Bottom"/></Grid>
            <TextBlock Text="Как выбрать приложение" Classes="label"/><ComboBox ItemsSource="{Binding SelectorNames}" SelectedIndex="{Binding RuleSelectorIndex}"/>
            <TextBox Text="{Binding RuleValue}" Watermark="{Binding RuleValuePlaceholder}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock Text="Сеть" Classes="label"/><ComboBox ItemsSource="{Binding NetworkNames}" SelectedIndex="{Binding RuleNetworkIndex}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Действие" Classes="label"/><ComboBox ItemsSource="{Binding ActionNames}" SelectedIndex="{Binding RuleActionIndex}"/></StackPanel></Grid>
            <StackPanel Spacing="8" IsVisible="{Binding IsProxyAction}"><TextBlock Text="Прокси-профиль" Classes="label"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding RuleProfile}"/><TextBlock Text="Если прокси недоступен, совпавшее соединение блокируется без переключения на прямой доступ." Classes="hint"/></StackPanel>
            <CheckBox IsChecked="{Binding RuleIncludeChildren}" IsEnabled="{Binding ExperimentalProcessTrees}"><TextBlock Text="Включать дочерние процессы (точное дерево PID, TCP Experimental)" TextWrapping="Wrap"/></CheckBox>
            <TextBlock Text="Правило по имени охватывает все экземпляры этого EXE. Для HTTP/HTTPS CONNECT выбирайте TCP. Для UDP нужен SOCKS5 и разрешение в настройках. Дерево PID (Experimental) привязано к конкретному запуску: выберите главный процесс, а после перезапуска создайте новое правило. UDP для дерева пока недоступен." Classes="hint"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"><Button Content="Сохранить" Classes="accent" Command="{Binding SaveRuleCommand}"/><Button Content="Удалить" Command="{Binding DeleteRuleCommand}"/></StackPanel>
          </StackPanel></Border></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Процессы">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="0,18,0,0">
          <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10"><TextBox Text="{Binding ProcessSearch}" Watermark="Поиск по имени, PID или пути…"/><ComboBox Grid.Column="1" ItemsSource="{Binding ProcessSortOptions}" SelectedItem="{Binding ProcessSort}"/><Button Grid.Column="2" Content="Обновить" Command="{Binding RefreshProcessesCommand}" IsEnabled="{Binding CanUseTools}"/></Grid>
          <TextBlock Grid.Row="1" Text="{Binding ProcessSummary}" Classes="hint"/>
          <Grid Grid.Row="2" ColumnDefinitions="190,70,100,*,145" Margin="13,0,20,0"><TextBlock Text="Имя процесса" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Родитель PID" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Путь EXE" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Запущен (UTC)" FontWeight="SemiBold"/></Grid>
          <ListBox Grid.Row="3" ItemsSource="{Binding Processes}" SelectedItems="{Binding SelectedProcesses}" SelectionMode="Multiple,Toggle"><ListBox.ItemTemplate><DataTemplate x:DataType="domain:ProcessInfo"><Grid ColumnDefinitions="190,70,100,*,145" MinHeight="40" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding ParentPid}" VerticalAlignment="Center" Classes="hint"/><TextBlock Grid.Column="3" Text="{Binding PathDisplay}" VerticalAlignment="Center" Classes="hint" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathDisplay}"/><TextBlock Grid.Column="4" Text="{Binding StartTimeUtc, StringFormat='{}{0:dd.MM HH:mm:ss}'}" VerticalAlignment="Center" Classes="hint"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Grid.Row="4" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanEdit}"><Button Content="Создать по имени" Command="{Binding CreateNameRulesCommand}"/><Button Content="Создать по пути EXE" Command="{Binding CreatePathRulesCommand}"/><Button Content="Дерево выбранного PID" Command="{Binding CreatePidTreeRulesCommand}" IsEnabled="{Binding ExperimentalProcessTrees}"/></StackPanel><TextBlock Text="Можно выбрать несколько процессов. Новые правила используют первый включённый профиль и TCP. Путь защищённого процесса может быть недоступен. Для дерева PID нужны доступные время создания и системный номер экземпляра. Соединения и объём трафика здесь не измеряются." Classes="hint"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Диагностика">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,18,0,0">
          <ScrollViewer><StackPanel Spacing="16">
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Проверить прокси" Classes="heading"/><TextBlock Text="Профиль" Classes="label"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding DiagnosticProfile}" IsEnabled="{Binding CanUseTools}"/><Grid ColumnDefinitions="*,100" ColumnSpacing="10" IsEnabled="{Binding CanUseTools}"><TextBox Text="{Binding TargetHost}" Watermark="Целевой хост TCP"/><TextBox Grid.Column="1" Text="{Binding TargetPort}" Watermark="Порт"/></Grid><StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanUseTools}"><Button Content="TCP CONNECT" Command="{Binding TestTcpCommand}" Classes="accent"/><Button Content="Проверить UDP" Command="{Binding TestUdpCommand}"/></StackPanel><TextBlock Text="TCP проверяет соединение через прокси. «Проверить UDP» отправляет проверочный DNS-запрос через SOCKS5 на 1.1.1.1:53, без собственного echo-сервера и без прямого обхода." Classes="hint"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="UDP — текущая сессия" Classes="heading"/><SelectableTextBlock Text="{Binding LiveUdpText}" TextWrapping="Wrap"/><Button Content="Начать / остановить сбор метрик" Command="{Binding ToggleUdpRecordingCommand}"/><CheckBox Content="Идёт запись метрик" IsChecked="{Binding IsRecordingUdp, Mode=OneWay}" IsHitTestVisible="False"/><SelectableTextBlock Text="{Binding UdpRecordingPath}" TextWrapping="Wrap"/><TextBlock Text="Обновление каждые 2 секунды. Счётчики отправки/приёма не измеряют потери, RTT или jitter произвольного приложения. Содержимое пакетов и credentials не записываются." Classes="hint"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="UDP echo через relay" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Укажите UDP echo-сервер, который вы контролируете: буквальный IP и порт. Тест отправит 3 случайных пакета. Адрес 127.0.0.1 относится к стороне upstream-прокси; echo-сервис должен работать там." Classes="hint"/><Grid ColumnDefinitions="*,100" ColumnSpacing="10" IsEnabled="{Binding CanEdit}"><TextBox Text="{Binding UdpEchoHost}" Watermark="IP вашего UDP echo-сервера"/><TextBox Grid.Column="1" Text="{Binding UdpEchoPort}" Watermark="Порт"/></Grid><Button Content="Проверить UDP echo" Command="{Binding TestUdpEchoCommand}" IsEnabled="{Binding CanEdit}" Classes="accent"/><TextBlock Text="Тест доступен при остановленном движке: результат сохраняется в профиле. Успех подтверждает только проверенный relay и цель; TUN, DNS и Discord voice не проверяются." Classes="hint"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Результат диагностики" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DiagnosticUdpStatus}" Classes="hint"/><SelectableTextBlock Text="{Binding DiagnosticText}" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Row="1" Classes="card"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="10"><TextBlock Text="Журнал сессии" FontSize="20" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Только безопасные события текущего запуска. Секреты и ответы сервера не записываются." Classes="hint"/><ListBox Grid.Row="2" ItemsSource="{Binding LogEntries}"><ListBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,4"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Настройки">
        <ScrollViewer><Grid ColumnDefinitions="3*,2*" ColumnSpacing="20" Margin="0,18,0,0">
          <Border Classes="card"><StackPanel Spacing="10" IsEnabled="{Binding CanEdit}"><TextBlock Text="Движок и приложение" Classes="heading"/><Button Content="Установить движок PathFlux" Command="{Binding InstallEngineCommand}" Classes="accent" HorizontalAlignment="Left"/><TextBlock Text="Установка из проверенного пакета этой сборки без UAC. Путь и контрольная сумма заполнятся и сохранятся автоматически. Движок PathFlux основан на sing-box 1.14.3 и поддерживает обычные правила и дерево PID." Classes="hint"/><TextBlock Text="Путь к движку (можно указать свой sing-box ≥ 1.12.2)" Classes="label"/><TextBox Text="{Binding EnginePath}" Watermark="C:\Tools\sing-box\sing-box.exe"/><TextBlock Text="SHA-256 исполняемого файла" Classes="label"/><TextBox Text="{Binding EngineSha256}" Watermark="64 символа SHA-256 выбранного EXE"/><TextBlock Text="Кнопка выше устанавливает модифицированную сборку PathFlux с исходниками и лицензией. Для своего движка укажите путь и SHA-256 вручную. Версия и контрольная сумма проверяются перед каждым запуском." Classes="hint"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock Text="Тема" Classes="label"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Обновление процессов, сек." Classes="label"/><TextBox Text="{Binding RefreshSeconds}"/></StackPanel></Grid><CheckBox Content="Обходить локальные сети (LAN)" IsChecked="{Binding BypassLan}"/><TextBlock Text="LAN bypass имеет приоритет перед пользовательскими правилами и разрешает локальный трафик напрямую." Classes="hint"/><TextBlock Text="Сеть и дополнительные возможности" FontWeight="SemiBold" FontSize="18" Margin="0,12,0,0"/><CheckBox IsChecked="{Binding ExperimentalProcessTrees}"><TextBlock Text="Точное дерево PID — отдельный backend (Experimental)" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Нужна отдельная сборка PathFlux Process Tree и её SHA-256. Дерево доступно только для TCP; UDP-правила дерева не разрешены до приёмки. TCP-правило не охватывает UDP: действуют остальные правила и Direct по умолчанию. Официальный sing-box будет отклонён. Новые потоки с неподтверждённой принадлежностью блокируются; DNS, WFP и VPN не перенастраиваются. Рабочий движок автоматически не заменяется." Classes="hint"/><CheckBox IsChecked="{Binding ExperimentalSocksUdp}"><TextBlock Text="Разрешить UDP через SOCKS5 (голос, видео, игры)" TextWrapping="Wrap"/></CheckBox><TextBlock Text="После включения сохраните настройки и выберите «TCP + UDP» в нужном правиле. HTTP/HTTPS CONNECT не поддерживают UDP. При отказе прокси трафик не отправляется напрямую. Новое сочетание сервера и приложения проверяйте отдельно." Classes="hint"/><Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" Classes="accent" Margin="0,8,0,0"/></StackPanel></Border>
          <StackPanel Grid.Column="1" Spacing="18"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Локальные данные" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="%LOCALAPPDATA%\PathFlux&#10;config.json — профили, правила, настройки&#10;secrets\ — Windows DPAPI CurrentUser&#10;&#10;Обычный JSON содержит только ссылки на секреты. Запуск сети выполняет отдельный агент с подтверждением UAC." TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Что важно знать" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="PathFlux направляет трафик выбранных приложений через ваш прокси. Сам прокси и VPN программа не предоставляет. Совместимость зависит от сервера; после настройки проверьте нужное приложение.&#10;&#10;DNS: System. Защиты от DNS leaks и системного kill switch нет. Сторонние VPN/WFP-фильтры приложение не изменяет.&#10;&#10;После проверки остановите движок и дождитесь подтверждения восстановления сети." Classes="hint"/></StackPanel></Border></StackPanel>
        </Grid></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="50" Height="4" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12"/></Grid></Border>
  </Grid>
</Window>
